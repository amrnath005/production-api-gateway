APP_NAME=api-gateway
APP_VERSION=1.0.0
ENVIRONMENT=development

USER_SERVICE_URL=http://localhost:8002
ORDER_SERVICE_URL=http://localhost:8003

REQUEST_TIMEOUT=5
RATE_LIMIT=5
RATE_LIMIT_WINDOW=60

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=60

API_KEY=change-me-in-production
API_KEY_HEADER=X-API-Key

JAEGER_ENDPOINT=http://localhost:14268/api/traces
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10
CACHE_TTL_SECONDS=60
CACHE_BYPASS=false
OTEL_SERVICE_NAME=api-gateway

DATABASE_URL=postgresql+asyncpg://gateway:gateway_password@localhost:5432/api_gateway
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_ECHO=false

POSTGRES_DB=api_gateway
POSTGRES_USER=gateway
POSTGRES_PASSWORD=gateway_password

# Docker Compose overrides
COMPOSE_PROJECT_NAME=api-gateway-project
INSTANCE_NAME=user-service-1
